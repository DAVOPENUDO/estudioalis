<%- include('partials/header') %>

<!-- ===== PAGE HEADER ===== -->
<section class="page-header">
  <div class="container">
    <span class="section__label">Lo Que Hacemos</span>
    <h1 class="page-header__title">Nuestros <span class="highlight-gold">Servicios</span></h1>
    <p class="page-header__subtitle">Cada servicio está pensado para realzar tu belleza única con técnicas profesionales y productos de calidad</p>
  </div>
</section>

<!-- ===== SERVICES ===== -->
<section class="section">
  <div class="container">

    <!-- Category 1: Cambios de Imagen -->
    <div class="service-category reveal">
      <div class="service-category__header">
        <div class="service-category__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
        </div>
        <div>
          <h2 class="service-category__title">Cambios de Imagen</h2>
          <p class="service-category__subtitle">Transformaciones completas que renuevan tu estilo y autoestima</p>
        </div>
      </div>

      <div class="services-grid">
        <div class="service-item">
          <h3 class="service-item__name">Cambio de Imagen Completo</h3>
          <p class="service-item__desc">Una transformación integral que incluye corte, color, peinado y maquillaje para un resultado impactante y armonioso</p>

        </div>
        <div class="service-item">
          <h3 class="service-item__name">Asesoría de Estilo Personal</h3>
          <p class="service-item__desc">Análisis personalizado de tu tipo de rostro, tono de piel y estilo de vida para definir tu look ideal</p>

        </div>
        <div class="service-item">
          <h3 class="service-item__name">Look para Evento Especial</h3>
          <p class="service-item__desc">Preparación completa para bodas, graduaciones, fiestas y cualquier ocasión que requiera un look memorable</p>

        </div>
      </div>
    </div>

    <!-- Category 2: Color & Efectos -->
    <div class="service-category reveal">
      <div class="service-category__header">
        <div class="service-category__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="13.5" cy="6.5" r="2.5"/>
            <circle cx="19" cy="13" r="2.5"/>
            <circle cx="6" cy="12" r="2.5"/>
            <circle cx="12" cy="19" r="2.5"/>
            <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20"/>
          </svg>
        </div>
        <div>
          <h2 class="service-category__title">Color y Efectos</h2>
          <p class="service-category__subtitle">Técnicas avanzadas de coloración que dan dimensión y vida a tu cabello</p>
        </div>
      </div>

      <div class="services-grid">
        <div class="service-item">
          <h3 class="service-item__name">Balayage y Mechas</h3>
          <p class="service-item__desc">Técnica de iluminación natural con transiciones suaves y elegantes para un resultado moderno y sofisticado</p>

        </div>
        <div class="service-item">
          <h3 class="service-item__name">Color Fantasía</h3>
          <p class="service-item__desc">Colores vibrantes y creativos que expresan tu personalidad: rosa, azul, violeta, verde y más combinaciones únicas</p>

        </div>
        <div class="service-item">
          <h3 class="service-item__name">Tinte Global y Retoque</h3>
          <p class="service-item__desc">Aplicación uniforme de color para cobertura total o retoque de raíz, con productos de alta durabilidad</p>

        </div>
        <div class="service-item">
          <h3 class="service-item__name">Decoloración y Platinado</h3>
          <p class="service-item__desc">Proceso profesional de decoloración con protección capilar para lograr rubios platinos, cenizos y bases para color</p>

        </div>
      </div>
    </div>

    <!-- Category 3: Maquillaje -->
    <div class="service-category reveal">
      <div class="service-category__header">
        <div class="service-category__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
        </div>
        <div>
          <h2 class="service-category__title">Maquillaje</h2>
          <p class="service-category__subtitle">Maquillaje profesional para cada ocasión, resaltando tu belleza natural</p>
        </div>
      </div>

      <div class="services-grid">
        <div class="service-item">
          <h3 class="service-item__name">Maquillaje Social</h3>
          <p class="service-item__desc">Look elegante y natural para compromisos sociales, cenas, reuniones y cualquier evento que requiera un acabado impecable</p>

        </div>
        <div class="service-item">
          <h3 class="service-item__name">Maquillaje de Novia</h3>
          <p class="service-item__desc">Preparación especializada para el día más importante, con productos de larga duración y acabado fotográfico perfecto</p>

        </div>
        <div class="service-item">
          <h3 class="service-item__name">Maquillaje Editorial</h3>
          <p class="service-item__desc">Looks artísticos y creativos para sesiones fotográficas, producciones y proyectos que requieren alta definición</p>

        </div>
      </div>
    </div>

    <!-- Category 4: Peinado -->
    <div class="service-category reveal">
      <div class="service-category__header">
        <div class="service-category__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 3v7c0 1.1.9 2 2 2h4l3 3 3-3h4c1.1 0 2-.9 2-2V3"/>
            <path d="M7 12v3c0 1.1.9 2 2 2h6c1.1 0 2-.9 2-2v-3"/>
          </svg>
        </div>
        <div>
          <h2 class="service-category__title">Peinado</h2>
          <p class="service-category__subtitle">Estilos y tratamientos capilares para toda ocasión</p>
        </div>
      </div>

      <div class="services-grid">
        <div class="service-item">
          <h3 class="service-item__name">Peinados para Eventos</h3>
          <p class="service-item__desc">Recogidos, trenzas, ondas y estilos elaborados para bodas, quinceañeras, graduaciones y eventos formales</p>

        </div>
        <div class="service-item">
          <h3 class="service-item__name">Corte y Estilo</h3>
          <p class="service-item__desc">Cortes de cabello personalizados que se adaptan a tu tipo de rostro, textura de cabello y estilo de vida</p>

        </div>
        <div class="service-item">
          <h3 class="service-item__name">Tratamientos Capilares</h3>
          <p class="service-item__desc">Hidratación profunda, keratina, alisados y tratamientos restauradores para un cabello saludable y brillante</p>

        </div>
      </div>
    </div>

    <!-- Category 5: Barberia -->
    <div class="service-category reveal">
      <div class="service-category__header">
        <div class="service-category__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="6" cy="6" r="3"/>
            <path d="M6 9v12"/>
            <circle cx="18" cy="18" r="3"/>
            <path d="M18 15V3"/>
          </svg>
        </div>
        <div>
          <h2 class="service-category__title">Barbería</h2>
          <p class="service-category__subtitle">Grooming masculino con precisión y estilo contemporáneo</p>
        </div>
      </div>

      <div class="services-grid">
        <div class="service-item">
          <h3 class="service-item__name">Corte Caballero</h3>
          <p class="service-item__desc">Cortes modernos, clásicos y de tendencia con atención al detalle, fade, undercut, texturas y estilos creativos</p>

        </div>
        <div class="service-item">
          <h3 class="service-item__name">Barba y Perfilado</h3>
          <p class="service-item__desc">Perfilado de barba con navaja, diseño de líneas definidas, hidratación y cuidado profesional de vello facial</p>

        </div>
        <div class="service-item">
          <h3 class="service-item__name">Combo Caballero</h3>
          <p class="service-item__desc">Servicio completo que incluye corte de cabello, perfilado de barba y acabado profesional con productos premium</p>

        </div>
      </div>
    </div>

  </div>
</section>

<!-- ===== CTA ===== -->
<section class="cta-banner">
  <div class="container">
    <h2 class="cta-banner__title reveal">
      El servicio perfecto <span class="highlight-gold">te espera</span>
    </h2>
    <p class="cta-banner__subtitle reveal reveal-delay-1">
      Agenda tu cita y deja que mis manos expertas hagan la magia
    </p>
    <div class="cta-banner__actions reveal reveal-delay-2">
      <a href="/agenda" class="btn btn--gold">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        Agendar Cita
      </a>
      <a href="<%= whatsappLink %>?text=Hola%2C%20me%20gustaria%20consultar%20sobre%20un%20servicio" target="_blank" rel="noopener" class="btn btn--whatsapp">
        <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Consultar por WhatsApp
      </a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
