<%- include('partials/header') %>

<!-- ===== HERO SECTION ===== -->
<section class="hero" id="hero">
  <div class="hero__bg">
    <img src="/images/hero-main.png" alt="Estudio de Belleza Alis - Transformaciones de imagen profesionales" loading="eager">
  </div>
  <div class="hero__overlay"></div>

  <div class="hero__content">
    <div class="hero__badge">
      <img src="/images/Logotipo.png" alt="Estudio de Belleza Alis" class="hero__logo-img">
    </div>

    <h1 class="hero__title">
      Estudio de Belleza <span class="highlight-gold">Alis</span>
    </h1>

    <div class="hero__actions">
      <a href="/agenda" class="btn btn--gold">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        Agendar Cita
      </a>
      <a href="<%= whatsappLink %>?text=Hola%2C%20me%20gustaria%20agendar%20una%20cita%20en%20Estudio%20de%20Belleza%20Alis" target="_blank" rel="noopener" class="btn btn--whatsapp">
        <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        WhatsApp Directo
      </a>
    </div>
  </div>
</section>

<!-- ===== SERVICES PREVIEW ===== -->
<section class="section section--dark" id="services-preview">
  <div class="container">
    <div class="section__header reveal">
      <span class="section__label">Nuestros Servicios</span>
      <h2 class="section__title">Arte y precisión en cada <span class="highlight-gold">detalle</span></h2>
      <p class="section__subtitle">Cada servicio es una experiencia personalizada, diseñada para realzar tu estilo único</p>
    </div>

    <div class="services-preview">
      <!-- Card 1: Cambios de Imagen -->
      <div class="service-card reveal reveal-delay-1">
        <div class="service-card__image">
          <img src="/images/gallery-transformation.png" alt="Cambios de imagen profesionales" loading="lazy">
        </div>
        <div class="service-card__body">
          <div class="service-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
          </div>
          <h3 class="service-card__title">Cambios de Imagen</h3>
          <p class="service-card__desc">Transformaciones completas que renuevan tu estilo y potencian tu confianza personal</p>
          <a href="/servicios" class="service-card__link">Conocer más &rarr;</a>
        </div>
      </div>

      <!-- Card 2: Color & Efectos -->
      <div class="service-card reveal reveal-delay-2">
        <div class="service-card__image">
          <img src="/images/color-effects.png" alt="Efectos de color en el cabello" loading="lazy">
        </div>
        <div class="service-card__body">
          <div class="service-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="13.5" cy="6.5" r="2.5"/>
              <circle cx="19" cy="13" r="2.5"/>
              <circle cx="6" cy="12" r="2.5"/>
              <circle cx="12" cy="19" r="2.5"/>
              <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20"/>
            </svg>
          </div>
          <h3 class="service-card__title">Color y Efectos</h3>
          <p class="service-card__desc">Balayage, mechas, color fantasía y técnicas avanzadas que dan vida a tu cabello</p>
          <a href="/servicios" class="service-card__link">Conocer más &rarr;</a>
        </div>
      </div>

      <!-- Card 3: Maquillaje -->
      <div class="service-card reveal reveal-delay-3">
        <div class="service-card__image">
          <img src="/images/makeup-service.png" alt="Maquillaje profesional" loading="lazy">
        </div>
        <div class="service-card__body">
          <div class="service-card__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </div>
          <h3 class="service-card__title">Maquillaje Profesional</h3>
          <p class="service-card__desc">Maquillaje social, de novia y editorial con técnicas que resaltan tu belleza natural</p>
          <a href="/servicios" class="service-card__link">Conocer más &rarr;</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== ABOUT PREVIEW ===== -->
<section class="section" id="about-preview">
  <div class="container">
    <div class="about-preview">
      <div class="about-preview__image reveal">
        <img src="/images/about-portrait.png" alt="Luz Alicia - Estilista profesional" loading="lazy">
      </div>

      <div class="about-preview__content reveal reveal-delay-2">
        <span class="section__label" style="text-align: left; display: block;">Sobre Mí</span>
        <h2 class="section__title" style="text-align: left; margin-bottom: 20px;">Donde la <span class="highlight-gold">pasión</span> se convierte en arte</h2>
        
        <blockquote class="about-preview__quote">
          "Cada persona tiene una belleza única que merece ser revelada"
        </blockquote>

        <p class="about-preview__text">
          Soy Luz Alicia, fundadora y estilista principal de Estudio de Belleza Alis. 
          Con años de dedicación al arte de la belleza, mi compromiso es ofrecerte 
          una experiencia transformadora que va más allá de lo estético.
        </p>

        <div class="about-preview__stats">
          <div class="stat">
            <div class="stat__number" data-count="100" data-suffix="+">0</div>
            <div class="stat__label">Clientes</div>
          </div>
          <div class="stat">
            <div class="stat__number" data-count="3" data-suffix="">0</div>
            <div class="stat__label">Años</div>
          </div>
          <div class="stat">
            <div class="stat__number" data-count="100" data-suffix="%">0</div>
            <div class="stat__label">Dedicación</div>
          </div>
        </div>

        <a href="/nosotros" class="btn btn--outline">Conocer mi historia &rarr;</a>
      </div>
    </div>
  </div>
</section>

<!-- ===== CTA BANNER ===== -->
