    <h2 class="cta-banner__title reveal">
      Tu <span class="highlight-gold">transformación</span> comienza hoy
    </h2>
    <p class="cta-banner__subtitle reveal reveal-delay-1">
      Agenda tu cita y descubre la mejor versión de ti
    </p>
    <div class="cta-banner__actions reveal reveal-delay-2">
      <a href="/agenda" class="btn btn--gold">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        Agendar Cita
      </a>
      <a href="<%= whatsappLink %>?text=Hola%2C%20me%20gustaria%20agendar%20una%20cita" target="_blank" rel="noopener" class="btn btn--whatsapp">
        <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
