    <h2 class="cta-banner__title reveal">
      Comienza tu <span class="highlight-gold">transformación</span>
    </h2>
    <p class="cta-banner__subtitle reveal reveal-delay-1">
      Te espero en Estudio de Belleza Alis para crear algo extraordinario juntos
    </p>
    <div class="cta-banner__actions reveal reveal-delay-2">
      <a href="/agenda" class="btn btn--gold">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        Agendar Cita
      </a>
      <a href="<%= whatsappLink %>?text=Hola%2C%20quiero%20conocer%20m%C3%A1s%20sobre%20los%20servicios" target="_blank" rel="noopener" class="btn btn--whatsapp">
