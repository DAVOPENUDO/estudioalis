<%- include('partials/header') %>

<!-- ===== PAGE HEADER ===== -->
<section class="page-header">
  <div class="container">
    <span class="section__label">Conoce Mi Historia</span>
    <h1 class="page-header__title">Sobre <span class="highlight-gold">Mí</span></h1>
    <p class="page-header__subtitle">Detrás de cada transformación hay pasión, dedicación y amor por la belleza</p>
  </div>
</section>

<!-- ===== ABOUT STORY ===== -->
<section class="section">
  <div class="container">
    <div class="about-section">
      <div class="about__image-wrapper reveal">
        <img src="/images/about-portrait.png" alt="Luz Alicia - Estilista profesional" loading="lazy">
      </div>

      <div class="about__story reveal reveal-delay-2">
        <h3>Mi Pasión, <span class="highlight-gold">Tu Transformación</span></h3>
        <p>
          Soy Luz Alicia, la creadora y alma de Estudio de Belleza Alis. Desde muy 
          joven sentí una fascinación profunda por el poder transformador de la belleza 
          y la imagen personal.
        </p>
        <p>
          Con años de formación continua y cientos de clientes satisfechos, he 
          perfeccionado un enfoque que combina técnica profesional con sensibilidad 
          artística. Cada persona que llega a mi estudio recibe una experiencia 
          completamente personalizada.
        </p>
        <p>
          Mi filosofía es simple pero poderosa: no se trata solo de cambiar un look, 
          sino de revelar la mejor versión de cada persona. Trabajo con hombres y 
          mujeres por igual, entendiendo que la belleza no tiene género y que todos 
          merecen sentirse extraordinarios.
        </p>
        <p>
          En Estudio de Belleza Alis, cada corte, cada color y cada maquillaje es 
          una obra de arte creada con amor y profesionalismo.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ===== VALUES ===== -->
<section class="section section--dark">
  <div class="container">
    <div class="section__header reveal">
      <span class="section__label">Lo Que Nos Define</span>
      <h2 class="section__title">Valores que <span class="highlight-gold">inspiran</span></h2>
    </div>

    <div class="values-grid">
      <div class="value-card reveal reveal-delay-1">
        <div class="value-card__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
        </div>
        <h4 class="value-card__title">Excelencia</h4>
        <p class="value-card__desc">Cada detalle importa. Nos esforzamos por superar las expectativas en cada servicio</p>
      </div>

      <div class="value-card reveal reveal-delay-2">
        <div class="value-card__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="13.5" cy="6.5" r="2.5"/>
            <circle cx="19" cy="13" r="2.5"/>
            <circle cx="6" cy="12" r="2.5"/>
            <circle cx="12" cy="19" r="2.5"/>
            <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20"/>
          </svg>
        </div>
        <h4 class="value-card__title">Creatividad</h4>
        <p class="value-card__desc">Innovamos constantemente con técnicas y tendencias para resultados únicos</p>
      </div>

      <div class="value-card reveal reveal-delay-3">
        <div class="value-card__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
        </div>
        <h4 class="value-card__title">Cercanía</h4>
        <p class="value-card__desc">Escuchamos tus deseos y creamos un ambiente de confianza y calidez</p>
      </div>

      <div class="value-card reveal reveal-delay-4">
        <div class="value-card__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
          </svg>
        </div>
        <h4 class="value-card__title">Innovación</h4>
        <p class="value-card__desc">Nos mantenemos a la vanguardia con las últimas técnicas y productos</p>
      </div>
    </div>
  </div>
</section>

<!-- ===== QUOTE ===== -->
<section class="section">
  <div class="container" style="text-align: center;">
    <div class="reveal" style="max-width: 700px; margin: 0 auto;">
      <span class="section__label">Mi Promesa</span>
      <blockquote style="font-family: var(--font-elegant); font-size: clamp(1.3rem, 2.5vw, 1.8rem); font-style: italic; font-weight: 300; color: var(--white); line-height: 1.6; margin-bottom: 24px;">
        "No solo cambio tu imagen, revelo la versión más auténtica y radiante de quien eres"
      </blockquote>
      <p style="font-family: var(--font-body); font-size: 0.85rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold);">
        -- Luz Alicia
      </p>
    </div>
  </div>
</section>

<!-- ===== STATS ===== -->
<section class="section section--dark">
  <div class="container">
    <div class="about-preview__stats reveal" style="max-width: 600px; margin: 0 auto;">
      <div class="stat">
        <div class="stat__number" data-count="100" data-suffix="+">0</div>
        <div class="stat__label">Clientes Satisfechos</div>
      </div>
      <div class="stat">
        <div class="stat__number" data-count="3" data-suffix="">0</div>
        <div class="stat__label">Años de Experiencia</div>
      </div>
      <div class="stat">
        <div class="stat__number" data-count="100" data-suffix="%">0</div>
        <div class="stat__label">Dedicación</div>
      </div>
    </div>
  </div>
</section>

<!-- ===== CTA ===== -->
