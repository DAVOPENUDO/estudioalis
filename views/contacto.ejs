<%- include('partials/header') %>

<!-- ===== PAGE HEADER ===== -->
<section class="page-header">
  <div class="container">
    <span class="section__label">Estamos Para Ti</span>
    <h1 class="page-header__title"><span class="highlight-gold">Contacto</span></h1>
    <p class="page-header__subtitle">Conecta conmigo y comienza tu experiencia de belleza</p>
  </div>
</section>

<!-- ===== CONTACT CARDS ===== -->
<section class="section">
  <div class="container">
    <div class="contact-grid">
      <!-- WhatsApp -->
      <div class="contact-card reveal reveal-delay-1">
        <div class="contact-card__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </div>
        <h3 class="contact-card__title">WhatsApp</h3>
        <p class="contact-card__text"><%= businessPhone %></p>
        <p class="contact-card__text" style="font-size: 0.82rem; color: var(--gray);">Respuesta rápida y personalizada</p>
        <a href="<%= whatsappLink %>?text=Hola%2C%20me%20comunico%20desde%20la%20p%C3%A1gina%20web" target="_blank" rel="noopener" class="contact-card__link">Enviar mensaje &rarr;</a>
      </div>

      <!-- Facebook -->
      <div class="contact-card reveal reveal-delay-2">
        <div class="contact-card__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
          </svg>
        </div>
        <h3 class="contact-card__title">Facebook</h3>
        <p class="contact-card__text">Estudio de Belleza Alis</p>
        <p class="contact-card__text" style="font-size: 0.82rem; color: var(--gray);">Síguenos para ver las últimas novedades</p>
        <a href="<%= facebookLink %>" target="_blank" rel="noopener" class="contact-card__link">Visitar &rarr;</a>
      </div>

      <!-- Horario -->
      <div class="contact-card reveal reveal-delay-3">
        <div class="contact-card__icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
        </div>
        <h3 class="contact-card__title">Horario</h3>
        <p class="contact-card__text">Lunes a Sábado</p>
        <p class="contact-card__text" style="font-size: 0.82rem; color: var(--gray);">Consulta disponibilidad por WhatsApp</p>
        <a href="/agenda" class="contact-card__link">Agendar cita &rarr;</a>
      </div>
    </div>

    <!-- Quick Contact Form -->
    <div class="contact-form-wrapper">
      <div class="form-container reveal">
        <h3 class="form-container__title" style="text-align: center;">Enviar un mensaje rápido</h3>
        <p class="form-container__subtitle" style="text-align: center;">Escribe tu mensaje y te contactaré por WhatsApp</p>

        <form id="contact-form">
          <div class="form-group">
            <label for="contact-nombre">Tu nombre *</label>
            <input type="text" id="contact-nombre" name="nombre" placeholder="Tu nombre" required>
          </div>

          <div class="form-group">
            <label for="contact-mensaje">Tu mensaje *</label>
            <textarea id="contact-mensaje" name="mensaje" placeholder="Cuéntame cómo puedo ayudarte" rows="4" required></textarea>
          </div>

          <div class="form-submit">
            <button type="submit" class="btn btn--gold" style="width: 100%; justify-content: center;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
              Enviar por WhatsApp
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- ===== CTA ===== -->
<section class="cta-banner">
  <div class="container">
    <h2 class="cta-banner__title reveal">
      Lista para tu <span class="highlight-gold">transformación</span>?
    </h2>
    <p class="cta-banner__subtitle reveal reveal-delay-1">
      Agenda tu cita y descubre lo que podemos lograr juntos
    </p>
    <div class="cta-banner__actions reveal reveal-delay-2">
      <a href="/agenda" class="btn btn--gold">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        Agendar Cita
      </a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
