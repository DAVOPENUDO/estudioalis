<%- include('partials/header') %>

<!-- ===== PAGE HEADER ===== -->
<section class="page-header">
  <div class="container">
    <span class="section__label">Grooming Masculino</span>
    <h1 class="page-header__title">Barbería <span class="highlight-gold">Premium</span></h1>
    <p class="page-header__subtitle">Donde la tradición se encuentra con la elegancia moderna en manos expertas</p>
  </div>
</section>

<!-- ===== BARBER GALLERY ===== -->
<section class="section">
  <div class="container">
    <div class="section__header reveal">
      <h2 class="section__title">Nuestros <span class="highlight-gold">Servicios</span></h2>
      <p class="section__subtitle">Cada detalle cuenta. Ofrecemos una experiencia de cuidado personal diseñada exclusivamente para el caballero contemporáneo.</p>
    </div>

    <div class="gallery-grid">
      <!-- 1. Corte de cabello -->
      <div class="gallery-item reveal reveal-delay-1">
        <img src="/images/barber-corte.png" alt="Corte de cabello masculino profesional" loading="lazy">
        <div class="gallery-item__overlay">
          <div>
            <div class="gallery-item__caption">Corte de Cabello</div>
            <div class="gallery-item__tag">Clásico y Tendencia</div>
          </div>
        </div>
      </div>

      <!-- 2. Degradados -->
      <div class="gallery-item reveal reveal-delay-2">
        <img src="/images/barber-fade.png" alt="Corte degradado o fade perfecto" loading="lazy">
        <div class="gallery-item__overlay">
          <div>
            <div class="gallery-item__caption">Degradados (Fade)</div>
            <div class="gallery-item__tag">Precisión Máxima</div>
          </div>
        </div>
      </div>

      <!-- 3. Arreglo de barba -->
      <div class="gallery-item reveal reveal-delay-3">
        <img src="/images/barber-barba.png" alt="Arreglo y perfilado de barba" loading="lazy">
        <div class="gallery-item__overlay">
          <div>
            <div class="gallery-item__caption">Arreglo de Barba</div>
            <div class="gallery-item__tag">Perfilado y Cuidado</div>
          </div>
        </div>
      </div>

      <!-- 4. Afeitado con navaja -->
      <div class="gallery-item reveal reveal-delay-1">
        <img src="/images/barber-navaja.png" alt="Afeitado tradicional con navaja" loading="lazy">
        <div class="gallery-item__overlay">
          <div>
            <div class="gallery-item__caption">Afeitado con Navaja</div>
            <div class="gallery-item__tag">Ritual Tradicional</div>
          </div>
        </div>
      </div>

      <!-- 5. Diseño de ceja -->
      <div class="gallery-item reveal reveal-delay-2">
        <img src="/images/barber-ceja.png" alt="Diseño de ceja para caballero" loading="lazy">
        <div class="gallery-item__overlay">
          <div>
            <div class="gallery-item__caption">Diseño de Ceja</div>
            <div class="gallery-item__tag">Definición Masculina</div>
          </div>
        </div>
      </div>


      <!-- 7. Tinte de cabello -->
      <div class="gallery-item reveal reveal-delay-1">
        <img src="/images/barber-tinte.png" alt="Tinte de cabello para hombre" loading="lazy">
        <div class="gallery-item__overlay">
          <div>
            <div class="gallery-item__caption">Tinte de Cabello</div>
            <div class="gallery-item__tag">Color y Matiz</div>
          </div>
        </div>
      </div>

      <!-- 8. Tratamientos faciales -->
      <div class="gallery-item reveal reveal-delay-2">
        <img src="/images/barber-facial.png" alt="Tratamiento facial relajante" loading="lazy" style="filter: brightness(0.9) contrast(1.1);">
        <div class="gallery-item__overlay">
          <div>
            <div class="gallery-item__caption">Tratamientos Faciales</div>
            <div class="gallery-item__tag">Limpieza y Relax</div>
          </div>
        </div>
      </div>

      <!-- 9. Corte para niño -->
      <div class="gallery-item reveal reveal-delay-3">
        <img src="/images/barber-nino.png" alt="Corte de cabello para niños" loading="lazy">
        <div class="gallery-item__overlay">
          <div>
            <div class="gallery-item__caption">Corte para Niño</div>
            <div class="gallery-item__tag">Estilo para los Pequeños</div>
          </div>
        </div>
      </div>

      <!-- 10. Paquetes de corte y barba -->
      <div class="gallery-item reveal reveal-delay-1">
        <img src="/images/barber-combo.png" alt="Paquete completo de corte y barba" loading="lazy">
        <div class="gallery-item__overlay">
          <div>
            <div class="gallery-item__caption">Paquetes Corte y Barba</div>
            <div class="gallery-item__tag">Experiencia Completa</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== INFO SECTION ===== -->
<section class="section section--dark">
  <div class="container">
    <div class="about-preview">
      <div class="about-preview__content reveal">
        <span class="section__label" style="text-align: left; display: block;">Experiencia Alis</span>
        <h2 class="section__title" style="text-align: left; margin-bottom: 20px;">Atención <span class="highlight-gold">Personalizada</span></h2>
        <p class="about-preview__text">
          En mi estudio, la barbería es más que un simple corte; es un momento de relajación y renovación. 
          Utilizo técnicas de alta precisión y productos premium para asegurar que cada cliente salga con un look 
          que proyecte confianza y estilo.
        </p>
        <ul class="agenda-info__features" style="margin-bottom: 30px;">
          <li class="agenda-info__feature">
            <div class="agenda-info__feature-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <span>Técnicas de corte con tijera y máquina</span>
          </li>
          <li class="agenda-info__feature">
            <div class="agenda-info__feature-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <span>Afeitado con toalla caliente</span>
          </li>
          <li class="agenda-info__feature">
            <div class="agenda-info__feature-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            </div>
            <span>Ambiente limpio, moderno y acogedor</span>
          </li>
        </ul>
        <a href="/agenda" class="btn btn--gold">Reservar mi lugar ahora</a>
      </div>
      <div class="about-preview__image reveal reveal-delay-2">
        <img src="/images/barber-combo.png" alt="Acabado profesional de barbería" loading="lazy" style="border-radius: 4px;">
      </div>
    </div>
  </div>
</section>

<!-- ===== CTA ===== -->
<section class="cta-banner">
  <div class="container">
    <h2 class="cta-banner__title reveal">
      ¿Listo para un <span class="highlight-gold">nuevo look</span>?
    </h2>
    <p class="cta-banner__subtitle reveal reveal-delay-1">
      Agenda tu cita hoy mismo y vive la experiencia de Barbería Premium
    </p>
    <div class="cta-banner__actions reveal reveal-delay-2">
      <a href="/agenda" class="btn btn--gold">Agendar Cita</a>
      <a href="<%= whatsappLink %>?text=Hola%2C%20me%20gustaria%20agendar%20un%20servicio%20de%20barberia" target="_blank" rel="noopener" class="btn btn--whatsapp">
         Consultar por WhatsApp
      </a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
